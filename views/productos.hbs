<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Productos</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <h1>Productos</h1>

    {{#each productos}}
        <div>
            <h2>{{nombre}}</h2>
            <p>Categoría: {{categoria}}</p>
            <p>Stock: {{stock}}</p>
            <p>Precio: ${{precio}}</p>
        </div>
    {{/each}}
</body>
</html>